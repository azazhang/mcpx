# Canonical filesystem scope visible to MCPX.
MCPX_BASE_DIR=/absolute/path/to/your/project-root

# HTTP transport. MCPX has no authentication layer; keep this loopback-only
# unless you place an authenticated transport in front of it.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=9090
MCP_HTTP_ENDPOINT=/mcp

# Durable workspace / recovery locations.
# MCPX_WORKSPACE_ROOT=$HOME/.local/share/mcpx-workspaces
# MCPX_RECOVERY_DIR=/absolute/path/to/durable-mcpx-state

# Command execution is intentionally OFF by default.
# Enable only for a trusted local deployment.
MCPX_ENABLE_COMMAND_EXECUTION=0

# If command execution is enabled:
#   none  = no OS sandbox; commands run as your user inside workspace cwd.
#   codex = use `codex sandbox` with the mcpx_agent profile.
MCPX_WORKSPACE_SANDBOX=none
# MCPX_CODEX_BIN=/absolute/path/to/codex
# MCPX_CODEX_PROFILE=mcpx_agent
# MCPX_SHELL=/bin/zsh

# Optional Poppler overrides for PDF text extraction.
# MCPX_PDFINFO_BIN=/absolute/path/to/pdfinfo
# MCPX_PDFTOTEXT_BIN=/absolute/path/to/pdftotext

# Optional response preservation budgets.
# MCPX_SEMANTIC_RESPONSE_LIMIT_BYTES=32768
# MCPX_MODEL_RESPONSE_LIMIT_BYTES=262144
# MCPX_TRANSPORT_POST_LIMIT_BYTES=0
# MCPX_TRANSPORT_ENVELOPE_BYTES=0
